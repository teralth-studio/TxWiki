PORT=3000
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_NAME=Teralth Studio
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-generated-16-character-password
BASE_URL=http://127.0.0.1:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=false
DB_USER=teralthwiki
DB_PASSWORD=replace-with-database-password
DB_NAME=teralthwiki
DB_POOL_LIMIT=5
DATA_DIR=./data
# Maximum image upload size in MB (positive integer).
IMAGE_UPLOAD_MAX_MB=50
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Teralth Wiki <no-reply@example.com>

# Optional: set a stable random secret (32+ bytes) for encrypted backup database snapshots.
BACKUP_ENCRYPTION_KEY=

# Optional Ed25519 public key override for custom builds (PEM or OpenSSH ssh-ed25519).
# Official packages use the bundled OpenSSH key by default.
# UPDATE_PUBLIC_KEY="ssh-ed25519 <base64-key> comment"
